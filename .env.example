# Example environment configuration for Bit Rot Detector
# Copy this file to .env and customize with your settings

# ===================================
# TARGET DIRECTORY CONFIGURATION
# ===================================

# Directory(ies) to monitor for bit rot
# For single drive:
TARGET_DIRECTORY=/path/to/monitor

# For multiple drives (comma-separated):
# TARGET_DIRECTORY=/path/to/drive1,/path/to/drive2,/path/to/drive3

# ===================================
# SMTP EMAIL CONFIGURATION
# ===================================

# SMTP server settings (default: SMTP2GO)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587

# SMTP credentials
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password

# Email addresses
SMTP_SENDER=sender@example.com
SMTP_RECIPIENT=recipient@example.com

# ===================================
# NOTIFICATION PREFERENCES
# ===================================

# Send email on successful operations (sync or scrub completed without issues)
# Note: Emails are ALWAYS sent on failure/warning (bit rot detected, critical errors)
# Options: true, false
NOTIFY_ON_SUCCESS=true

# ===================================
# SCRUB CONFIGURATION
# ===================================

# Percentage of files to scrub per run (0.1 to 100.0)
# Example: 1.0 = scrub 1% of files each run
# Example: 10.0 = scrub 10% of files each run
SCRUB_PERCENTAGE=1.0

# Scrub frequency
# Options: daily | weekly | monthly
# - daily: Scrub eligible files every run (no age filter)
# - weekly: Only scrub files not verified in the last 7 days
# - monthly: Only scrub files not verified in the last 30 days
SCRUB_FREQUENCY=daily

# ===================================
# LOGGING CONFIGURATION
# ===================================

# Number of days to keep log files (old logs are auto-deleted)
LOG_RETENTION_DAYS=7

# ===================================
# PERFORMANCE CONFIGURATION
# ===================================

# Maximum number of concurrent workers for multi-drive processing
# Default: 4
# Set to the number of drives for maximum parallelism
MAX_WORKERS=4
